clusters:
  - kind  # replace with your kubectl context name
  # If you keep separate dev clusters per provider (see `make setup-dev-cluster
  # CLUSTER_NAME=...` in CONTRIBUTING.md), list all their contexts here,
  # e.g.:
  # - kind-istio
  # - kind-calico
  # - kind-cilium

controller:
  image: controller
  providerName: "istio"

# Used only when controller.providerName is istio. This is a Tilt build setting,
# not the Helm chart values path (controller.provider.istio.agent.image).
agent:
  image: agent
