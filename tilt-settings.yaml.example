clusters:
  - kind  # replace with your kubectl context name
  # If you keep separate dev clusters per provider (see `make setup-dev-cluster
  # CLUSTER_NAME=...` in CONTRIBUTING.md), list all their contexts here,
  # e.g.:
  # - kind-istio
  # - kind-calico
  # - kind-cilium

controller:
  image: controller
  providerName: "istio"

agent:
  image: agent
