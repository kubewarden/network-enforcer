FROM registry.suse.com/bci/golang:1.27.0 AS builder

WORKDIR /src
COPY api/ /src/api
COPY cmd/ /src/cmd
COPY internal/ /src/internal
COPY go.mod go.sum /src/
COPY Makefile /src/
RUN make controller

FROM scratch
WORKDIR /
COPY --from=builder /src/bin/controller /controller

USER 65532:65532
ENTRYPOINT ["/controller"]
